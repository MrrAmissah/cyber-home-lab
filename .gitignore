# Packet captures and raw evidence (never commit raw captures)
*.pcap
*.pcapng
*.cap
*.etl
evidence/raw/

# Secrets and config with credentials
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.kdbx
secrets/
credentials*

# VM and container images
*.ova
*.ovf
*.vdi
*.vmdk
*.qcow2
*.iso
*.img
.vagrant/

# Logs and dumps
*.log
*.dmp
*.mem
*.core

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python / Node
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Allow explicitly sanitised excerpts
!*.sanitized.pcapng
